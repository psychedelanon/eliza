# Bitcoin Aqua Engagement System Configuration

# Redis Configuration (Required for network coordination)
REDIS_URL=redis://localhost:6379

# Twitter API Configuration (Required for posting)
TWITTER_API_KEY=your_twitter_api_key_here
TWITTER_API_SECRET=your_twitter_api_secret_here
TWITTER_ACCESS_TOKEN=your_twitter_access_token_here
TWITTER_ACCESS_TOKEN_SECRET=your_twitter_access_token_secret_here

# Network Coordination Settings
NETWORK_COORDINATION_ENABLED=true
MAX_NETWORK_AGENTS=4
COORDINATION_WINDOW_MS=300000

# Engagement Settings
ENGAGEMENT_DELAY_MIN_MS=15000
ENGAGEMENT_DELAY_MAX_MS=300000
AMPLIFICATION_PROBABILITY=0.8

# Content Strategy Settings
TRENDING_TOPICS_REFRESH_MS=300000
CONTENT_QUALITY_THRESHOLD=0.8

# Performance Monitoring
METRICS_RETENTION_HOURS=168
ANALYTICS_BATCH_SIZE=50

# Bitcoin Aqua Optimal Timing (UTC)
OPTIMAL_POSTING_HOURS=8,12,16,20,24
TIMEZONE_OFFSET=0

# Network Analytics Weights
INFLUENCE_SCORE_WEIGHT=0.4
ENGAGEMENT_RATE_WEIGHT=0.4
REACH_WEIGHT=0.2

# Bitcoin Aqua Specific Settings
BITCOIN_AQUA_DAILY_ENGAGEMENT_TARGET=500
BITCOIN_AQUA_WEEKLY_FOLLOWER_GROWTH=1000
BITCOIN_AQUA_MONTHLY_MINSHARE_INCREASE=25

# Logging Configuration
LOG_LEVEL=info
LOG_FILE=bitcoinaqua-engagement.log

# Development Settings
NODE_ENV=production
DEBUG=false
