# ElizaOS Swarm Production Environment Configuration
# Copy this file to .env and fill in your actual values

# ==========================================
# TWITTER API CREDENTIALS - one set per agent
# ==========================================

# Agent 1 - LoreMaster
AGENT1_CONSUMER_KEY=your_consumer_key_here
AGENT1_CONSUMER_SECRET=your_consumer_secret_here
AGENT1_ACCESS_TOKEN=your_access_token_here
AGENT1_ACCESS_SECRET=your_access_secret_here

# Agent 2 - HypeBeast (Price Bot)
AGENT2_CONSUMER_KEY=your_consumer_key_here
AGENT2_CONSUMER_SECRET=your_consumer_secret_here
AGENT2_ACCESS_TOKEN=your_access_token_here
AGENT2_ACCESS_SECRET=your_access_secret_here

# Agent 3 - MemeLord
AGENT3_CONSUMER_KEY=your_consumer_key_here
AGENT3_CONSUMER_SECRET=your_consumer_secret_here
AGENT3_ACCESS_TOKEN=your_access_token_here
AGENT3_ACCESS_SECRET=your_access_secret_here

# Agent 4 - AlphaScry
AGENT4_CONSUMER_KEY=your_consumer_key_here
AGENT4_CONSUMER_SECRET=your_consumer_secret_here
AGENT4_ACCESS_TOKEN=your_access_token_here
AGENT4_ACCESS_SECRET=your_access_secret_here

# Agent 5 - GremlinGM
AGENT5_CONSUMER_KEY=your_consumer_key_here
AGENT5_CONSUMER_SECRET=your_consumer_secret_here
AGENT5_ACCESS_TOKEN=your_access_token_here
AGENT5_ACCESS_SECRET=your_access_secret_here

# ==========================================
# INFRASTRUCTURE CONFIGURATION
# ==========================================

# Redis Configuration
REDIS_URL=redis://redis:6379/0

# Startup Configuration
STARTUP_DELAY=300  # 5 minutes safety buffer in seconds

# Logging Configuration
SWARM_LOG_LEVEL=INFO

# ==========================================
# LLM PROVIDER CONFIGURATION
# ==========================================

# OpenAI Configuration (primary)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4-turbo-preview

# Anthropic Configuration (backup)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ==========================================
# MONITORING & OBSERVABILITY
# ==========================================

# Grafana Configuration
GRAFANA_PASSWORD=secure_grafana_password_here

# Prometheus/Metrics Configuration
METRICS_ENABLED=true
METRICS_PORT=8080

# ==========================================
# SECURITY & COMPLIANCE
# ==========================================

# Rate Limiting Configuration
MAX_TWEETS_PER_HOUR=50
MAX_REPLIES_PER_HOUR=30
MAX_LIKES_PER_HOUR=100

# Content Moderation
CONTENT_FILTER_ENABLED=true
SPAM_DETECTION_ENABLED=true

# ==========================================
# OPERATIONAL CONFIGURATION
# ==========================================

# Environment
ENVIRONMENT=production

# Feature Flags
ENABLE_CROSS_ENGAGEMENT=true
ENABLE_FAKE_ARGUMENTS=true
ENABLE_PRICE_REACTIONS=true

# Database Configuration
DATABASE_URL=sqlite:///data/eliza.db

# Backup Configuration
BACKUP_ENABLED=true
BACKUP_INTERVAL=3600  # 1 hour in seconds 