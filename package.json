{
  "name": "bitcoinaqua-engagement-system",
  "version": "1.0.0",
  "description": "Advanced Twitter engagement optimization system for Bitcoin Aqua mindshare campaigns",
  "main": "bitcoinaqua-launch-script.ts",
  "scripts": {
    "start": "tsx bitcoinaqua-launch-script.ts",
    "dev": "tsx --watch bitcoinaqua-launch-script.ts",
