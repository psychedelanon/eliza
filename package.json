    "ioredis": "^5.3.0",
    "axios": "^1.6.0",
    "node-cron": "^3.0.3",
    "winston": "^3.11.0",
    "dotenv": "^16.3.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/redis": "^4.0.11",
    "typescript": "^5.0.0",
    "tsx": "^4.0.0",
    "vitest": "^1.0.0"
  },
  "keywords": [
    "bitcoin",
    "aqua",
    "twitter",
    "engagement",
    "social-media",
    "cryptocurrency",
    "defi",
